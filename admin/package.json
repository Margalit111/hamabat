{
  "name": "hamabat-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "deploy": "wrangler deploy",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.168.0"
  }
}
